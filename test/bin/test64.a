; OS LINUX
; ARCH AMD-64
section .text
global _start
_start:
	 call main
exit:
	push rbp
	mov rbp, rsp
	sub rsp, 16
	mov rcx, [rbp + 16]
	mov [rbp - 8], rcx
	mov rax, 60
	mov rdi, [rbp - 8]
	syscall
	add rsp, 16
	pop rbp
ret 8
main:
	push rbp
	mov rbp, rsp
	sub rsp, 16
	mov rdx, 42
	mov [rbp - 8], rdx
	mov rdx, [rbp - 8]
	push rdx
	call exit
	add rsp, 16
	pop rbp
ret
