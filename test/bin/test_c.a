; OS LINUX
; ARCH AMD-64
section .text
global _start
_start:
	call main

; rbp frame after push rbp & mov rbp, rsp
; [rbp + 24] arg0
; [rbp + 16] arg1
; [rbp + 8] rip
; [rbp + 0] previous rbp
; [rbp - 8] var 0 
; [rpb - 16] var 1

exit:
	push rbp
	mov rbp, rsp
	sub rsp, 16
	mov rcx, [rbp + 16]
	mov [rbp - 8], rcx
	mov rax, 60
	mov rdi, [rbp - 8]
	syscall
	add rsp, 16
	pop rbp
ret
main:
	push rbp
	mov rbp, rsp
	sub rsp, 16
	mov rdx, 42
	mov [rbp - 8], rdx
	mov rdx, 4
	mov [rbp - 16], rdx
	mov rdx, [rbp - 8]
	push rdx
	call exit
	add rsp, 16
	pop rbp
ret